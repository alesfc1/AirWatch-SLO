# Sentinel Hub credentials — required to run the data pipeline.
# Copy this file to `.env` (it is git-ignored) and fill in your values.
#
# Get credentials at https://www.sentinel-hub.com/ → Dashboard → User settings → OAuth clients
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Optional: switch to Copernicus Data Space Ecosystem (CDSE) instead of Sinergise
# SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# SH_STATISTICS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
